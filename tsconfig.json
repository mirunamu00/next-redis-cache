{
  // Editor and typecheck config: covers src/, tests and config files (no emit).
  // The publish build (tsup dts) uses tsconfig.build.json, which only sees src/.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Tests import scripts/lib/*.mjs (gate rules): infer their types, but do not type-check the JS itself
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "*.config.ts"],
  "exclude": ["dist", "node_modules", ".work", ".artifacts", "test-apps"]
}
