{
  "name": "@mirunamu/next-redis-cache",
  "version": "1.1.0",
  "description": "Redis cache handlers for Next.js 16 (legacy cacheHandler and \"use cache\" cacheHandlers) with build-output fallback, circuit breaker and old-build cleanup",
  "license": "MIT",
  "author": "mirunamu00",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirunamu00/next-redis-cache.git"
  },
  "homepage": "https://github.com/mirunamu00/next-redis-cache#readme",
  "bugs": {
    "url": "https://github.com/mirunamu00/next-redis-cache/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./use-cache": {
      "import": {
        "types": "./dist/use-cache.d.ts",
        "default": "./dist/use-cache.js"
      },
      "require": {
        "types": "./dist/use-cache.d.cts",
        "default": "./dist/use-cache.cjs"
      }
    },
    "./instrumentation": {
      "import": {
        "types": "./dist/instrumentation.d.ts",
        "default": "./dist/instrumentation.js"
      },
      "require": {
        "types": "./dist/instrumentation.d.cts",
        "default": "./dist/instrumentation.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.ts",
        "default": "./dist/redis.js"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project property --project contract",
    "test:unit": "vitest run --project unit",
    "test:prop": "vitest run --project property",
    "test:coverage": "vitest run --project unit --project property --project contract --coverage",
    "test:watch": "vitest --project unit --project property",
    "test:int": "vitest run --project integration",
    "test:fault": "vitest run --project fault --project fault-docker",
    "test:fault:nodocker": "vitest run --project fault",
    "test:all": "node scripts/test-all.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:ps": "node scripts/infra.mjs ps",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:cli": "node scripts/infra.mjs cli",
    "quality": "node scripts/quality.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "check-no-hangul": "node scripts/check-no-hangul.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "pack:local": "node scripts/pack.mjs",
    "apps:prepare": "node scripts/prepare-app.mjs",
    "fleet": "node scripts/fleet.mjs",
    "origin": "node scripts/origin-server.mjs",
    "test:contract": "vitest run --project contract && node scripts/contract-types.mjs --variant all",
    "test:e2e": "playwright test",
    "test:contract:oracle": "vitest run --project contract",
    "test:contract:types": "node scripts/contract-types.mjs --variant all",
    "test:chaos": "vitest run --project chaos",
    "test:perf": "node scripts/perf.mjs --check",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@redis/client": "^5.0.0 || ^6.0.0",
    "next": "^16.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@redis/client": "^5.10.0",
    "@size-limit/file": "^14.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "next": "^16.1.4",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^14.1.0",
    "testcontainers": "~12.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
