{
  "name": "@mirunamu/next-redis-cache",
  "version": "1.0.6",
  "description": "Redis cache handler for Next.js 16 — supports both legacy cacheHandler (ISR) and use-cache cacheHandlers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./use-cache": {
      "types": "./dist/use-cache.d.ts",
      "import": "./dist/use-cache.js",
      "require": "./dist/use-cache.cjs"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "import": "./dist/instrumentation.js",
      "require": "./dist/instrumentation.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project property",
    "test:unit": "vitest run --project unit",
    "test:prop": "vitest run --project property",
    "test:coverage": "vitest run --project unit --project property --coverage",
    "test:watch": "vitest --project unit --project property",
    "test:int": "vitest run --project integration",
    "test:fault": "vitest run --project fault --project fault-docker",
    "test:fault:nodocker": "vitest run --project fault",
    "test:all": "node scripts/test-all.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:ps": "node scripts/infra.mjs ps",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:cli": "node scripts/infra.mjs cli",
    "quality": "node scripts/quality.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "check-no-hangul": "node scripts/check-no-hangul.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "pack:local": "node scripts/pack.mjs",
    "apps:prepare": "node scripts/prepare-app.mjs",
    "fleet": "node scripts/fleet.mjs",
    "origin": "node scripts/origin-server.mjs",
    "test:contract": "node scripts/contract-types.mjs --variant all",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@redis/client": ">=5.0.0",
    "next": ">=15.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@redis/client": "^5.10.0",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "next": "^16.1.4",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^14.1.0",
    "testcontainers": "~12.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
